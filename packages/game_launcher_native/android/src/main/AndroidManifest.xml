<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fermer les processus d'arrière-plan (permission « normale », accordée à l'installation). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Rend l'appli visible dans « Accès Ne pas déranger » des réglages Android. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Voir et lancer les autres applis (obligatoire depuis Android 11).
         Évite la permission QUERY_ALL_PACKAGES, très restreinte par Google Play. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

</manifest>
